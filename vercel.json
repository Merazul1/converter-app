{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/es",
      "destination": "/es.html"
    },
    {
      "source": "/es/",
      "destination": "/es.html"
    },
    {
      "source": "/es/:path*",
      "destination": "/es.html"
    },
    {
      "source": "/ar",
      "destination": "/ar.html"
    },
    {
      "source": "/ar/",
      "destination": "/ar.html"
    },
    {
      "source": "/ar/:path*",
      "destination": "/ar.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
